From c703b371607a77559293c5cfd7b8cdff635be873 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Tethering NAT with iptables-legacy after ui-wpa3

Source: op-tether c703b3716; rebased onto wifi_manager.py blob 411eb5b7e
(upstream cd487f563 + ui-wpa3.patch); additions unchanged.

diff --git a/openpilot/system/ui/lib/tests/test_tethering_nat.py b/openpilot/system/ui/lib/tests/test_tethering_nat.py
new file mode 100644
index 0000000..7a8ebae
--- /dev/null
+++ b/openpilot/system/ui/lib/tests/test_tethering_nat.py
@@ -0,0 +1,104 @@
+"""Tests for the legacy iptables NAT rule managed by WifiManager tethering."""
+import subprocess
+from unittest.mock import MagicMock, call
+
+import pytest
+
+from openpilot.system.ui.lib import wifi_manager
+from openpilot.system.ui.lib.wifi_manager import TETHERING_NAT_RULE, WifiManager
+
+
+@pytest.fixture
+def wm(monkeypatch):
+  monkeypatch.setattr(WifiManager, '_initialize', MagicMock())
+  manager = WifiManager.__new__(WifiManager)
+  manager._exit = True
+  manager._conn_monitor = MagicMock()
+  manager._tethering_ssid = "weedle"
+  manager._ipv4_forward = True
+  manager.activate_connection = MagicMock()
+  manager._deactivate_connection = MagicMock()
+
+  def synchronous_thread(*, target, daemon):
+    thread = MagicMock()
+    thread.start.side_effect = target
+    return thread
+
+  monkeypatch.setattr(wifi_manager.threading, 'Thread', synchronous_thread)
+  return manager
+
+
+@pytest.fixture
+def run(monkeypatch):
+  run = MagicMock(return_value=subprocess.CompletedProcess([], 0))
+  monkeypatch.setattr(wifi_manager.subprocess, 'run', run)
+  return run
+
+
+def test_activate_adds_missing_rule_after_connection(wm, run):
+  run.side_effect = [subprocess.CompletedProcess([], 1), subprocess.CompletedProcess([], 0)]
+  calls = MagicMock()
+  calls.attach_mock(wm.activate_connection, 'activate')
+  calls.attach_mock(run, 'run')
+
+  wm.set_tethering_active(True)
+
+  assert calls.mock_calls == [
+    call.activate(wm._tethering_ssid, block=True),
+    call.run(["sudo", "iptables-legacy", "-t", "nat", "-C", *TETHERING_NAT_RULE],
+             check=False, capture_output=True, text=True),
+    call.run(["sudo", "iptables-legacy", "-t", "nat", "-A", *TETHERING_NAT_RULE],
+             check=True, capture_output=True, text=True),
+  ]
+
+
+def test_activate_keeps_existing_rule(wm, run):
+  wm.set_tethering_active(True)
+
+  run.assert_called_once_with(["sudo", "iptables-legacy", "-t", "nat", "-C", *TETHERING_NAT_RULE],
+                              check=False, capture_output=True, text=True)
+
+
+def test_activate_missing_iptables_does_not_raise(wm, run, monkeypatch):
+  run.side_effect = FileNotFoundError("iptables-legacy")
+  log_exception = MagicMock()
+  monkeypatch.setattr(wifi_manager.cloudlog, 'exception', log_exception)
+
+  wm.set_tethering_active(True)
+
+  run.assert_called_once_with(["sudo", "iptables-legacy", "-t", "nat", "-C", *TETHERING_NAT_RULE],
+                              check=False, capture_output=True, text=True)
+  log_exception.assert_called_once_with("Failed to add tethering NAT rule")
+
+
+def test_deactivate_removes_rule_after_connection(wm, run):
+  run.return_value = subprocess.CompletedProcess([], 1)
+  calls = MagicMock()
+  calls.attach_mock(wm._deactivate_connection, 'deactivate')
+  calls.attach_mock(run, 'run')
+
+  wm.set_tethering_active(False)
+
+  assert calls.mock_calls == [
+    call.deactivate(wm._tethering_ssid),
+    call.run(["sudo", "iptables-legacy", "-t", "nat", "-D", *TETHERING_NAT_RULE],
+             check=False, capture_output=True, text=True),
+  ]
+
+
+def test_activate_without_forwarding_still_disables_ip_forward(wm, run, monkeypatch):
+  wm._ipv4_forward = False
+  sleep = MagicMock()
+  monkeypatch.setattr(wifi_manager.time, 'sleep', sleep)
+  calls = MagicMock()
+  calls.attach_mock(run, 'run')
+  calls.attach_mock(sleep, 'sleep')
+
+  wm.set_tethering_active(True)
+
+  assert calls.mock_calls == [
+    call.run(["sudo", "iptables-legacy", "-t", "nat", "-C", *TETHERING_NAT_RULE],
+             check=False, capture_output=True, text=True),
+    call.sleep(5),
+    call.run(["sudo", "sysctl", "net.ipv4.ip_forward=0"], check=False),
+  ]
diff --git a/openpilot/system/ui/lib/wifi_manager.py b/openpilot/system/ui/lib/wifi_manager.py
index 411eb5b..7d6976a 100644
--- a/openpilot/system/ui/lib/wifi_manager.py
+++ b/openpilot/system/ui/lib/wifi_manager.py
@@ -37,6 +37,9 @@ else:
     Params = None
 
 TETHERING_IP_ADDRESS = "192.168.43.1"
+TETHERING_SUBNET = "192.168.43.0/24"
+TETHERING_NAT_RULE = ["POSTROUTING", "-s", TETHERING_SUBNET, "!", "-d", TETHERING_SUBNET, "-j", "MASQUERADE",
+                      "-m", "comment", "--comment", "openpilot-tethering"]
 DEFAULT_TETHERING_PASSWORD = "swagswagcomma"
 SIGNAL_QUEUE_SIZE = 10
 SCAN_PERIOD_SECONDS = 5
@@ -71,6 +74,10 @@ def _supports_sae() -> bool:
     return False
 
 
+def _sudo(*cmd: str, check: bool = True) -> subprocess.CompletedProcess:
+  return subprocess.run(["sudo", *cmd], check=check, capture_output=True, text=True)
+
+
 def normalize_ssid(ssid: str) -> str:
   return ssid.replace("’", "'")  # for iPhone hotspots
 
@@ -844,12 +851,23 @@ class WifiManager:
       if active:
         self.activate_connection(self._tethering_ssid, block=True)
 
+        # NM's shared-mode NAT fails on AGNOS: its iptables is the nft variant and the kernel has no nf_tables.
+        try:
+          if _sudo("iptables-legacy", "-t", "nat", "-C", *TETHERING_NAT_RULE, check=False).returncode != 0:
+            _sudo("iptables-legacy", "-t", "nat", "-A", *TETHERING_NAT_RULE)
+        except (FileNotFoundError, subprocess.CalledProcessError, OSError):
+          cloudlog.exception("Failed to add tethering NAT rule")
+
         if not self._ipv4_forward:
           time.sleep(5)
           cloudlog.warning("net.ipv4.ip_forward = 0")
           subprocess.run(["sudo", "sysctl", "net.ipv4.ip_forward=0"], check=False)
       else:
         self._deactivate_connection(self._tethering_ssid)
+        try:
+          _sudo("iptables-legacy", "-t", "nat", "-D", *TETHERING_NAT_RULE, check=False)
+        except (FileNotFoundError, OSError):
+          cloudlog.exception("Failed to remove tethering NAT rule")
 
     threading.Thread(target=worker, daemon=True).start()
 
