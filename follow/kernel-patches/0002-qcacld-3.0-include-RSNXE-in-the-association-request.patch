From f02903ff521390f9c988173f7a9d63c2b437b064 Mon Sep 17 00:00:00 2001
From: shunnag <5158650+shunnag@users.noreply.github.com>
Date: Fri, 25 Sep 2026 21:04:56 +0900
Subject: [PATCH] qcacld-3.0: include RSNXE in the association request

Preserve the supplicant RSNXE for SAE H2E and keep the transmitted and
reported request IEs consistent with EAPOL message 2/4.

- Keep RSNXE from the connect IEs in HDD's association IE buffer.
- Make lim_send_assoc_req_mgmt_frame() work on a local copy of the
  additional IEs, as in 7c07f228f6. ExtCap and SuppOpClass stripping no
  longer changes the shared join request, so a PMF comeback retry
  rebuilds the same frame.
- Copy RSNXE and append it after dot11f packing, before FILS encryption
  and the assocReq copy returned to userspace.
- Include RSNXE only when the target BSS advertises it, regardless of
  AKM. This is intentionally broader than dfba36b6f: H2E is only used
  with such APs, and the STA's check of the AP's RSNXE in EAPOL message
  3/4 still provides downgrade protection.
- Always drop RSNXE for host reassociation because the roamed indication
  reports only SSID and RSN request IEs.
- Like c051588e6, append after all dot11f-packed elements, including
  vendor IEs. Upstream fixed ordering in 85d2c71f6 by regenerating
  dot11f, which is out of scope here.

Based on qcacld-3.0 commits c051588e6, dfba36b6f, and 7c07f228f6.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 .../core/hdd/src/wlan_hdd_cfg80211.c          |  7 ++
 .../core/mac/inc/sir_mac_prot_def.h           |  1 +
 .../src/pe/lim/lim_process_sme_req_messages.c | 23 +++++++
 .../src/pe/lim/lim_send_management_frames.c   | 67 +++++++++++++++++--
 4 files changed, 93 insertions(+), 5 deletions(-)

diff --git a/drivers/staging/qcacld-3.0/core/hdd/src/wlan_hdd_cfg80211.c b/drivers/staging/qcacld-3.0/core/hdd/src/wlan_hdd_cfg80211.c
index bb0ebcf..b3c9c8a 100644
--- a/drivers/staging/qcacld-3.0/core/hdd/src/wlan_hdd_cfg80211.c
+++ b/drivers/staging/qcacld-3.0/core/hdd/src/wlan_hdd_cfg80211.c
@@ -17994,6 +17994,13 @@ static int wlan_hdd_cfg80211_set_ie(hdd_adapter_t *pAdapter, const uint8_t *ie,
 					return status;
 				break;
 			}
+		case WLAN_ELEMID_RSNXE:
+			hdd_debug("Set RSNXE(len %d)", eLen + 2);
+			status = wlan_hdd_add_assoc_ie(pWextState, genie - 2,
+						       eLen + 2);
+			if (status)
+				return status;
+			break;
 		default:
 			hdd_err("Set UNKNOWN IE: %X", elementId);
 			/* when Unknown IE is received we should break and continue
diff --git a/drivers/staging/qcacld-3.0/core/mac/inc/sir_mac_prot_def.h b/drivers/staging/qcacld-3.0/core/mac/inc/sir_mac_prot_def.h
index 9096b36..be6f5fd 100644
--- a/drivers/staging/qcacld-3.0/core/mac/inc/sir_mac_prot_def.h
+++ b/drivers/staging/qcacld-3.0/core/mac/inc/sir_mac_prot_def.h
@@ -352,6 +352,7 @@
 #define SIR_MAC_RSN_EID                48
 #define SIR_MAC_RSN_EID_MIN                4
 #define SIR_MAC_RSN_EID_MAX                254
+#define WLAN_ELEMID_RSNXE              244
 
 /* using reserved EID for Qos Action IE for now, */
 /* need to check 11e spec for the actual EID */
diff --git a/drivers/staging/qcacld-3.0/core/mac/src/pe/lim/lim_process_sme_req_messages.c b/drivers/staging/qcacld-3.0/core/mac/src/pe/lim/lim_process_sme_req_messages.c
index 0fad542..5f19327 100644
--- a/drivers/staging/qcacld-3.0/core/mac/src/pe/lim/lim_process_sme_req_messages.c
+++ b/drivers/staging/qcacld-3.0/core/mac/src/pe/lim/lim_process_sme_req_messages.c
@@ -2063,6 +2063,7 @@ static void __lim_process_sme_reassoc_req(tpAniSirGlobal mac_ctx,
 	tpSirSmeJoinReq reassoc_req = NULL;
 	tLimMlmReassocReq *mlm_reassoc_req;
 	tSirResultCodes ret_code = eSIR_SME_SUCCESS;
+	tSirRetStatus sir_status;
 	tpPESession session_entry = NULL;
 	uint8_t session_id;
 	uint8_t sme_session_id;
@@ -2092,6 +2093,28 @@ static void __lim_process_sme_reassoc_req(tpAniSirGlobal mac_ctx,
 		goto end;
 	}
 
+	/*
+	 * The roamed indication reports only SSID and RSN request IEs.
+	 * Omit RSNXE so the request matches EAPOL message 2/4.
+	 */
+	if (wlan_cfg_get_ie_ptr(reassoc_req->addIEAssoc.addIEdata,
+				reassoc_req->addIEAssoc.length,
+				WLAN_ELEMID_RSNXE, ONE_BYTE)) {
+		pe_debug("Strip RSNXE: roamed indication cannot report it");
+		sir_status = lim_strip_ie(mac_ctx,
+					reassoc_req->addIEAssoc.addIEdata,
+					&reassoc_req->addIEAssoc.length,
+					WLAN_ELEMID_RSNXE, ONE_BYTE,
+					NULL, 0, NULL, 0);
+		if (eSIR_SUCCESS != sir_status) {
+			pe_err("Failed to strip RSNXE: %d", sir_status);
+			ret_code = sir_status == eSIR_MEM_ALLOC_FAILED ?
+				eSIR_SME_RESOURCES_UNAVAILABLE :
+				eSIR_SME_INVALID_PARAMETERS;
+			goto end;
+		}
+	}
+
 	session_entry = pe_find_session_by_bssid(mac_ctx,
 			reassoc_req->bssDescription.bssId,
 			&session_id);
diff --git a/drivers/staging/qcacld-3.0/core/mac/src/pe/lim/lim_send_management_frames.c b/drivers/staging/qcacld-3.0/core/mac/src/pe/lim/lim_send_management_frames.c
index abfaeb8..aee858f 100644
--- a/drivers/staging/qcacld-3.0/core/mac/src/pe/lim/lim_send_management_frames.c
+++ b/drivers/staging/qcacld-3.0/core/mac/src/pe/lim/lim_send_management_frames.c
@@ -1606,7 +1606,7 @@ lim_send_assoc_req_mgmt_frame(tpAniSirGlobal mac_ctx,
 	int ret;
 	tDot11fAssocRequest *frm;
 	uint16_t caps;
-	uint8_t *frame;
+	uint8_t *frame, *rsnx_ie = NULL;
 	tSirRetStatus sir_status;
 	tLimMlmAssocCnf assoc_cnf;
 	uint32_t bytes = 0, payload, status;
@@ -1614,7 +1614,9 @@ lim_send_assoc_req_mgmt_frame(tpAniSirGlobal mac_ctx,
 	void *packet;
 	QDF_STATUS qdf_status;
 	uint16_t add_ie_len, assoc_ack_status;
-	uint8_t *add_ie;
+	uint16_t rsnx_ie_len = 0;
+	uint8_t *add_ie = NULL;
+	const uint8_t *rsnx;
 	uint8_t *wps_ie = NULL;
 	uint8_t power_caps = false;
 	uint8_t tx_flag = 0;
@@ -1645,12 +1647,27 @@ lim_send_assoc_req_mgmt_frame(tpAniSirGlobal mac_ctx,
 		return;
 	}
 	add_ie_len = pe_session->pLimJoinReq->addIEAssoc.length;
-	add_ie = pe_session->pLimJoinReq->addIEAssoc.addIEdata;
+	if (add_ie_len) {
+		add_ie = qdf_mem_malloc(add_ie_len);
+		if (!add_ie) {
+			pe_err("Unable to allocate additional IE buffer");
+			qdf_mem_free(mlm_assoc_req);
+			return;
+		}
+		/*
+		 * IE stripping below must not modify the shared join request:
+		 * a PMF comeback retry needs the original additional IEs.
+		 */
+		qdf_mem_copy(add_ie,
+			     pe_session->pLimJoinReq->addIEAssoc.addIEdata,
+			     add_ie_len);
+	}
 
 	frm = qdf_mem_malloc(sizeof(tDot11fAssocRequest));
 	if (NULL == frm) {
 		pe_err("Unable to allocate memory");
 		qdf_mem_free(mlm_assoc_req);
+		qdf_mem_free(add_ie);
 		return;
 	}
 	qdf_mem_set((uint8_t *) frm, sizeof(tDot11fAssocRequest), 0);
@@ -1913,6 +1930,36 @@ lim_send_assoc_req_mgmt_frame(tpAniSirGlobal mac_ctx,
 		aes_block_size_len = AES_BLOCK_SIZE;
 	}
 
+	/*
+	 * Copy RSNXE without changing the shared join request, which is reused
+	 * for PMF comeback retries. dot11f skips this unknown IE.
+	 */
+	rsnx = wlan_cfg_get_ie_ptr(add_ie, add_ie_len, WLAN_ELEMID_RSNXE,
+				   ONE_BYTE);
+	if (rsnx) {
+		tSirBssDescription *bss_descr;
+
+		bss_descr = &pe_session->pLimJoinReq->bssDescription;
+		/* Do not send RSNXE to an AP that does not advertise it. */
+		if (wlan_cfg_get_ie_ptr((uint8_t *)bss_descr->ieFields,
+				lim_get_ielen_from_bss_description(bss_descr),
+				WLAN_ELEMID_RSNXE, ONE_BYTE)) {
+			rsnx_ie_len = rsnx[1] + 2;
+			if (rsnx_ie_len > add_ie_len - (rsnx - add_ie)) {
+				pe_err("Invalid RSNXE length: %d", rsnx_ie_len);
+				goto end;
+			}
+			rsnx_ie = qdf_mem_malloc(rsnx_ie_len);
+			if (!rsnx_ie) {
+				pe_err("Unable to allocate RSNXE buffer");
+				goto end;
+			}
+			qdf_mem_copy(rsnx_ie, rsnx, rsnx_ie_len);
+		} else {
+			pe_debug("Skip RSNXE: AP does not advertise it");
+		}
+	}
+
 	/*
 	 * Do unpack to populate the add_ie buffer to frm structure
 	 * before packing the frm structure. In this way, the IE ordering
@@ -1938,8 +1985,8 @@ lim_send_assoc_req_mgmt_frame(tpAniSirGlobal mac_ctx,
 			status);
 	}
 
-	bytes = payload + sizeof(tSirMacMgmtHdr) +
-			aes_block_size_len;
+	bytes = payload + sizeof(tSirMacMgmtHdr) + aes_block_size_len +
+		rsnx_ie_len;
 
 	qdf_status = cds_packet_alloc((uint16_t) bytes, (void **)&frame,
 				(void **)&packet);
@@ -1979,6 +2026,14 @@ lim_send_assoc_req_mgmt_frame(tpAniSirGlobal mac_ctx,
 		pe_warn("Assoc request pack warning (0x%08x)", status);
 	}
 
+	/* Include RSNXE before FILS encryption and saving the request IEs. */
+	if (rsnx_ie && rsnx_ie_len) {
+		qdf_mem_copy(frame + sizeof(tSirMacMgmtHdr) + payload,
+			     rsnx_ie, rsnx_ie_len);
+		payload += rsnx_ie_len;
+		pe_debug("RSNXE added to association request");
+	}
+
 	if (pe_session->assocReq != NULL) {
 		qdf_mem_free(pe_session->assocReq);
 		pe_session->assocReq = NULL;
@@ -2052,8 +2107,10 @@ lim_send_assoc_req_mgmt_frame(tpAniSirGlobal mac_ctx,
 	}
 
 end:
+	qdf_mem_free(rsnx_ie);
 	/* Free up buffer allocated for mlm_assoc_req */
 	qdf_mem_free(mlm_assoc_req);
+	qdf_mem_free(add_ie);
 	mlm_assoc_req = NULL;
 	qdf_mem_free(frm);
 	return;
-- 
2.54.0 (Apple Git-157)

