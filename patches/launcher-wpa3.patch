     AGNOS_PY="$DIR/openpilot/common/hardware/comma/agnos.py"
-    MANIFEST="$DIR/openpilot/system/hardware/comma/agnos.json"
+    wpa3_update_manifest
     if "$AGNOS_PY" --verify "$MANIFEST"; then
       sudo reboot
     fi
@@ -30,3 +179,5 @@
     done
   fi
+
+  wpa3_supplicant_override
 }
